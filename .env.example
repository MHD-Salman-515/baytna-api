# Node environment: development | production | test
NODE_ENV=development

# HTTP port the app listens on
PORT=3000

# API prefix (served under /<API_PREFIX>/...)
API_PREFIX=api/v1

# --- MongoDB ---
# Pick ONE option (see README "Option A: Atlas" / "Option B: local MongoDB"):
#
# Option A — MongoDB Atlas (mongodb+srv://):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/home-services?retryWrites=true&w=majority
#
# Option B — local MongoDB, no Docker, no auth (Windows MSI install — see README):
# MONGODB_URI=mongodb://localhost:27017/home-services
#
# Option C — local MongoDB via docker-compose, with auth:
# MONGODB_URI=mongodb://admin:change-me-strong-password@localhost:27017/home-services?authSource=admin
MONGODB_URI=mongodb://localhost:27017/home-services

# Only relevant for Option C (docker-compose). Generate a strong password,
# e.g.: openssl rand -hex 24. Avoid ':', '/', '@', '?', '#' — they need
# URL-encoding in MONGODB_URI above otherwise.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me-strong-password
MONGO_PORT=27017

# --- Redis (docker-compose; optional — see REDIS_URL below) ---
# No-Docker alternative: a managed free tier (e.g. Upstash, Redis Cloud) — see README.
REDIS_PORT=6379

# Optional. When set, the OTP store uses Redis at this URL instead of an
# in-memory store — needed as soon as you run more than one instance, or want
# OTP state to survive a restart. Leave unset for local dev (in-memory is fine
# for a single process). Example if using the docker-compose Redis:
# REDIS_URL=redis://localhost:6379

# Optional, comma-separated. If `npm run db:doctor` finds that Node's DNS
# resolver can't do SRV/TXT lookups (common on some Windows setups) even
# though `nslookup` works fine, set this and every connection attempt will
# use these servers instead of your OS default.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Comma-separated list of allowed CORS origins, or * for all
CORS_ORIGINS=*

# Rate limiting (requests per TTL window, TTL in seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Seeder safety guard: `npm run seed` refuses to run unless MONGODB_URI's host is
# localhost / 127.0.0.1 / mongodb (the docker-compose service name). Only set this
# to true if you deliberately intend to seed a non-local database.
ALLOW_REMOTE_SEED=false

# --- Auth (Phase 2) ---
# JWT signing secrets. MUST be different from each other — generate two
# separate values, e.g.: openssl rand -hex 32 (run it twice)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-1
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-2

# Server-side pepper mixed into the OTP code hash. Generate with, e.g.:
# openssl rand -hex 32
OTP_PEPPER=change-me-to-another-long-random-string

# Optional. Full E.164 number (e.g. +963911111111) for the seeder to
# idempotently create (or promote to ADMIN) a bootstrap admin user. Skipped
# with a warning if unset — you won't have any ADMIN user to log in as.
# SEED_ADMIN_PHONE=+963911111111

# --- Storage (Phase 3 — worker documents) ---
# Used only to build local-dev presigned-style download links
# (LocalFileStorage). Defaults to http://localhost:<PORT>; set explicitly if
# the app is reachable at a different host while developing (e.g. a LAN IP).
# PUBLIC_BASE_URL=http://localhost:3000

# Local dev storage default: directory worker documents are written to,
# outside anything this app serves. Ignored once S3_BUCKET is set below.
STORAGE_LOCAL_DIR=.local-storage

# Set S3_BUCKET to switch from LocalFileStorage to S3CompatibleStorage.
# Works with Cloudflare R2, Backblaze B2, MinIO, or real AWS S3 — plain S3
# API only (@aws-sdk/client-s3), so only the values below change per
# provider. See README "R2 setup" for the exact Cloudflare dashboard steps.
# Once S3_BUCKET is set, S3_REGION/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY become required.
# S3_BUCKET=home-services-worker-documents
# S3_REGION=auto
# S3_ACCESS_KEY_ID=change-me
# S3_SECRET_ACCESS_KEY=change-me
# Custom endpoint for R2/B2/MinIO; omit entirely for real AWS S3.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Some S3-compatible providers need path-style URLs instead of virtual-hosted-style.
# S3_FORCE_PATH_STYLE=false

# Days a departed worker's documents are kept before `npm run purge:documents`
# removes them for good. See README "Document retention".
DOCUMENT_RETENTION_DAYS=90

# Not validated by Joi — read directly by purge-documents.ts, same pattern as
# ALLOW_REMOTE_SEED. The script only reports what it would delete unless this
# is set to true for that one run:
# PURGE_EXECUTE=true
