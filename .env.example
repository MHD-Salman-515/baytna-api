# Node environment: development | production | test
NODE_ENV=development

# HTTP port the app listens on
PORT=3000

# API prefix (served under /<API_PREFIX>/...)
API_PREFIX=api/v1

# --- MongoDB ---
# Pick ONE option (see README "Option A: Atlas" / "Option B: local MongoDB"):
#
# Option A — MongoDB Atlas (mongodb+srv://):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/home-services?retryWrites=true&w=majority
#
# Option B — local MongoDB, no Docker, no auth (Windows MSI install — see README):
# MONGODB_URI=mongodb://localhost:27017/home-services
#
# Option C — local MongoDB via docker-compose, with auth:
# MONGODB_URI=mongodb://admin:change-me-strong-password@localhost:27017/home-services?authSource=admin
MONGODB_URI=mongodb://localhost:27017/home-services

# Only relevant for Option C (docker-compose). Generate a strong password,
# e.g.: openssl rand -hex 24. Avoid ':', '/', '@', '?', '#' — they need
# URL-encoding in MONGODB_URI above otherwise.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me-strong-password
MONGO_PORT=27017

# --- Redis (docker-compose; unused by the app until a later phase). ---
# No-Docker alternative: a managed free tier (e.g. Upstash, Redis Cloud) — see README.
REDIS_PORT=6379

# Optional, comma-separated. If `npm run db:doctor` finds that Node's DNS
# resolver can't do SRV/TXT lookups (common on some Windows setups) even
# though `nslookup` works fine, set this and every connection attempt will
# use these servers instead of your OS default.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Comma-separated list of allowed CORS origins, or * for all
CORS_ORIGINS=*

# Rate limiting (requests per TTL window, TTL in seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Placeholder admin gate for Phase 1 (replaced by real auth in a later phase).
# Generate a long random string, e.g.: openssl rand -hex 32
ADMIN_API_KEY=change-me-to-a-long-random-string

# Seeder safety guard: `npm run seed` refuses to run unless MONGODB_URI's host is
# localhost / 127.0.0.1 / mongodb (the docker-compose service name). Only set this
# to true if you deliberately intend to seed a non-local database.
ALLOW_REMOTE_SEED=false
